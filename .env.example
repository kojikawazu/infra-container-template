# このファイルを .env にコピーして使う:  cp .env.example .env
# .env は .gitignore 済み（シークレットをコミットしない）。

# ===== 起動プロファイル =====
# --profile を毎回付けたくない場合に指定（例: mysql,postgres / all）
# COMPOSE_PROFILES=all

# ===== MSSQL =====
MSSQL_SA_PASSWORD=Your_strong_Pass123   # 8文字以上＋大小英字/数字/記号のうち3種以上が必須
MSSQL_PID=Developer
MSSQL_PORT=1433

# ===== MySQL =====
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=appdb
MYSQL_USER=appuser
MYSQL_PASSWORD=apppass
MYSQL_PORT=3306

# ===== PostgreSQL =====
POSTGRES_DB=appdb
POSTGRES_USER=appuser
POSTGRES_PASSWORD=apppass
POSTGRES_PORT=5432

# ===== pgvector (ベクトル検索用 PostgreSQL・通常postgresとは別コンテナ) =====
PGVECTOR_DB=vectordb
PGVECTOR_USER=vectoruser
PGVECTOR_PASSWORD=vectorpass
PGVECTOR_PORT=5433

# ===== MariaDB =====
MARIADB_ROOT_PASSWORD=rootpass
MARIADB_DATABASE=appdb
MARIADB_USER=appuser
MARIADB_PASSWORD=apppass
MARIADB_PORT=3307

# ===== MongoDB =====
MONGO_ROOT_USERNAME=root
MONGO_ROOT_PASSWORD=rootpass
MONGO_DATABASE=appdb
MONGO_PORT=27017

# ===== DynamoDB Local =====
DYNAMODB_PORT=8000
AWS_REGION=ap-northeast-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# ===== Redis =====
REDIS_PASSWORD=redispass
REDIS_PORT=6379

# ===== MinIO (S3互換) =====
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ===== Kafka =====
KAFKA_PORT=9092
KAFKA_UI_PORT=8082

# ===== RabbitMQ =====
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=adminpass
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# ===== Mailpit (メール送信テスト) =====
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_MAX_MESSAGES=500

# ===== OpenSearch (全文検索) + Dashboards =====
OPENSEARCH_PORT=9200
OPENSEARCH_DASHBOARDS_PORT=5601
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m

# ===== Prometheus / Grafana / Loki / Tempo =====
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
LOKI_PORT=3100
TEMPO_PORT=3200
TEMPO_OTLP_GRPC_PORT=4317
TEMPO_OTLP_HTTP_PORT=4318

# ===== BigQuery emulator =====
BIGQUERY_PROJECT=local-project
BIGQUERY_REST_PORT=9050
BIGQUERY_GRPC_PORT=9060

# ===== LocalStack (AWS エミュレータ) =====
# image は 3系にピン留め済み（サインアップ不要・無料）。
# :latest(4系以降) を使う場合のみ、app.localstack.cloud の無料トークンを設定する。
# Lambda を使う場合のみ SERVICES に lambda を追加し、compose の docker.sock マウントを有効化する。
LOCALSTACK_PORT=4566
LOCALSTACK_SERVICES=s3,sqs,sns,dynamodb
LOCALSTACK_DEBUG=0
# LOCALSTACK_AUTH_TOKEN=

# ===== クライアント (Web UI) ポート =====
ADMINER_PORT=8080
ADMINER_DEFAULT_SERVER=postgres
MONGO_EXPRESS_PORT=8081
MONGO_EXPRESS_USER=admin
MONGO_EXPRESS_PASSWORD=admin
DYNAMODB_ADMIN_PORT=8001
REDISINSIGHT_PORT=5540
